  <name>Hotspot (apsta)</name>
  <summary>Share your internet over Wi-Fi while staying connected</summary>
  <developer id="io.github.krotrn">
    <name>krotrn</name>
  </developer>

  <description>
    <p>
      Run a Wi-Fi hotspot on Linux while your Wi-Fi card stays connected
      to your Wi-Fi network (AP+STA). apsta checks what your card can do, sets the
      hotspot up the right way for it, keeps it running after suspend or a
      channel change, and removes everything it added when you stop it.
    </p>
    <ul>
      <li>One button to start and stop the hotspot</li>
      <li>A QR code phones can scan to join</li>
      <li>See connected devices; limit their speed, disconnect or block them</li>
      <li>Wi-Fi Direct fallback when your Wi-Fi is on a channel the card can't host on</li>
      <li>A system tray icon to start, stop and switch the hotspot</li>
      <li>Profiles, a hidden network option and start at boot</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.github.apsta.Gtk.desktop</launchable>
  <provides>
    <binary>apsta</binary>
    <binary>apsta-gtk</binary>
  </provides>

