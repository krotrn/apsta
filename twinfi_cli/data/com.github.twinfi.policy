<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Lets twinfi-gtk run `pkexec /usr/bin/twinfi ...` with a clear prompt that names
  twinfi (not a generic "run /bin/sh as root"), and keeps the authorisation for
  a few minutes so each click doesn't ask again.
-->
<policyconfig>
  <vendor>twinfi</vendor>
  <vendor_url>https://github.com/krotrn/twinfi</vendor_url>
  <action id="com.github.twinfi.manage">
    <description>Manage the twinfi WiFi hotspot</description>
    <message>Authentication is required to manage the WiFi hotspot</message>
    <icon_name>network-wireless-hotspot-symbolic</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/twinfi</annotate>
  </action>
</policyconfig>
