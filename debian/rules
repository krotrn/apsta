#!/usr/bin/make -f
export DH_VERBOSE = 1

%:
	dh $@ --with python3 --buildsystem=pybuild

# Install the Python package into twinfi itself: with a second binary package
# (the transitional apsta) pybuild would otherwise stage it in debian/tmp.
override_dh_auto_install:
	dh_auto_install --destdir=debian/twinfi

# Shell completions are generated from the CLI, so they always match it.
execute_after_dh_auto_install:
	python3 -m twinfi_cli completion bash | install -Dm644 /dev/stdin debian/twinfi/usr/share/bash-completion/completions/twinfi
	python3 -m twinfi_cli completion zsh | install -Dm644 /dev/stdin debian/twinfi/usr/share/zsh/vendor-completions/_twinfi
	python3 -m twinfi_cli completion fish | install -Dm644 /dev/stdin debian/twinfi/usr/share/fish/vendor_completions.d/twinfi.fish
