# Maintainer: krotrn <krotrn.ks@gmail.com>
pkgname=apsta
pkgver=0.6.1
pkgrel=1
pkgdesc="Smart AP+STA WiFi hotspot manager for Linux"
arch=('any')
url="https://github.com/krotrn/apsta"
license=('MIT')
depends=(
  'python'
  'python-qrcode'
  'python-pillow'
  'networkmanager'
  'iw'
  'iproute2'
  'usbutils'
  'pciutils'
)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=(
  'hostapd: AP+STA on split-combination cards such as Intel AX200'
  'dnsmasq: DHCP for hotspot clients in hostapd mode'
  'iptables: NAT for hotspot clients in hostapd mode'
  'python-gobject: apsta-gtk GUI'
  'gtk4: apsta-gtk GUI'
  'libadwaita: apsta-gtk GUI'
  'polkit: privileged actions from apsta-gtk'
)
install=apsta.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1a733c687909f6aa58c88212e8b487f50ce37638b1f820db09b017d3bd8e71f5')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  python -m unittest discover -s tests
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 system/apsta.service -t "$pkgdir/usr/lib/systemd/system/"
  install -Dm755 system/apsta-sleep -t "$pkgdir/usr/lib/systemd/system-sleep/"
  install -Dm644 gtk-ui/com.github.apsta.Gtk.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
