# Maintainer: krotrn <krotrn.ks@gmail.com>
pkgname=twinfi
pkgver=0.13.0
pkgrel=1
pkgdesc="Run a Wi-Fi hotspot while staying connected to Wi-Fi (AP+STA)"
arch=('any')
url="https://github.com/krotrn/twinfi"
license=('MIT')
depends=(
  'python'
  'networkmanager'
  'iw'
  'iproute2'
  'usbutils'
  'pciutils'
)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-jeepney')
optdepends=(
  'hostapd: AP+STA on split-combination cards such as Intel AX200'
  'dnsmasq: DHCP for hotspot clients in hostapd mode'
  'iptables: NAT for hotspot clients in hostapd mode (or nftables / firewalld)'
  'python-gobject: twinfi-gtk GUI'
  'gtk4: twinfi-gtk GUI'
  'libadwaita: twinfi-gtk GUI'
  'polkit: privileged actions from twinfi-gtk'
  'python-qrcode: QR codes in twinfi-gtk'
  'python-pillow: QR codes in twinfi-gtk'
  'python-jeepney: Wi-Fi Direct hotspot when wpa_supplicant has no control socket'
)
# twinfi was called apsta until 0.13 (and installs an `apsta` alias).
provides=('apsta')
conflicts=('apsta')
replaces=('apsta')
install=twinfi.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# CI (packaging/arch/ci-build.sh release) pins the real sum for each tag.
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  python -m unittest discover -s tests -t .
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 twinfi_cli/data/twinfi.service -t "$pkgdir/usr/lib/systemd/system/"
  install -Dm755 twinfi_cli/data/twinfi-sleep -t "$pkgdir/usr/lib/systemd/system-sleep/"
  install -Dm644 twinfi_cli/data/com.github.twinfi.policy -t "$pkgdir/usr/share/polkit-1/actions/"
  install -Dm644 twinfi_gui/data/com.github.twinfi.Gtk.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 twinfi_gui/data/com.github.twinfi.Gtk.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
  install -Dm644 twinfi_gui/data/icons/hicolor/scalable/apps/com.github.twinfi.Gtk.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 twinfi_gui/data/icons/hicolor/symbolic/apps/com.github.twinfi.Gtk-symbolic.svg -t "$pkgdir/usr/share/icons/hicolor/symbolic/apps/"
  python -m twinfi_cli completion bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/twinfi"
  python -m twinfi_cli completion zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_twinfi"
  python -m twinfi_cli completion fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/twinfi.fish"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
