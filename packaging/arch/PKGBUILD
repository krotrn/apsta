# Maintainer: krotrn <krotrn.ks@gmail.com>
pkgname=apsta
pkgver=0.9.0
pkgrel=1
pkgdesc="Run a Wi-Fi hotspot while staying connected to Wi-Fi (AP+STA)"
arch=('any')
url="https://github.com/krotrn/apsta"
license=('MIT')
depends=(
  'python'
  'networkmanager'
  'iw'
  'iproute2'
  'usbutils'
  'pciutils'
)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-jeepney')
optdepends=(
  'hostapd: AP+STA on split-combination cards such as Intel AX200'
  'dnsmasq: DHCP for hotspot clients in hostapd mode'
  'iptables: NAT for hotspot clients in hostapd mode (or nftables / firewalld)'
  'python-gobject: apsta-gtk GUI'
  'gtk4: apsta-gtk GUI'
  'libadwaita: apsta-gtk GUI'
  'polkit: privileged actions from apsta-gtk'
  'python-qrcode: QR codes in apsta-gtk'
  'python-pillow: QR codes in apsta-gtk'
  'python-jeepney: Wi-Fi Direct hotspot when wpa_supplicant has no control socket'
)
install=apsta.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# CI (packaging/arch/ci-build.sh release) pins the real sum for each tag.
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  python -m unittest discover -s tests -t .
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 apsta_cli/data/apsta.service -t "$pkgdir/usr/lib/systemd/system/"
  install -Dm755 apsta_cli/data/apsta-sleep -t "$pkgdir/usr/lib/systemd/system-sleep/"
  install -Dm644 apsta_cli/data/com.github.apsta.policy -t "$pkgdir/usr/share/polkit-1/actions/"
  install -Dm644 apsta_gui/data/com.github.apsta.Gtk.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 apsta_gui/data/com.github.apsta.Gtk.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
  install -Dm644 apsta_gui/data/icons/hicolor/scalable/apps/com.github.apsta.Gtk.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 apsta_gui/data/icons/hicolor/symbolic/apps/com.github.apsta.Gtk-symbolic.svg -t "$pkgdir/usr/share/icons/hicolor/symbolic/apps/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
